{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiroku-forge.local/schemas/memory-v3.schema.json",
  "title": "KirokuForge Canonical Memory V3",
  "description": "Canonical project-memory contract for KirokuForge v3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "memory_id",
    "revision",
    "state_hash",
    "project",
    "sources",
    "records",
    "compilations"
  ],
  "properties": {
    "artifact_type": {
      "const": "memory"
    },
    "schema_version": {
      "const": "3.0.0"
    },
    "memory_id": {
      "$ref": "common-v1.schema.json#/$defs/memoryId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state_hash": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "compilations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/compilationReceipt"
      }
    }
  },
  "$defs": {
    "nullableHash": {
      "oneOf": [
        {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
      }
    },
    "slugArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common-v1.schema.json#/$defs/slug"
      }
    },
    "nonEmptySlugArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common-v1.schema.json#/$defs/slug"
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "goal",
        "status",
        "boundaries",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "name": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "goal": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "active",
            "paused",
            "completed",
            "archived"
          ]
        },
        "boundaries": {
          "$ref": "#/$defs/projectBoundaries"
        },
        "created_at": {
          "$ref": "common-v1.schema.json#/$defs/utcTimestamp"
        },
        "updated_at": {
          "$ref": "common-v1.schema.json#/$defs/utcTimestamp"
        }
      }
    },
    "projectBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
          }
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "uri",
        "integrity",
        "captured_at",
        "created_by"
      ],
      "properties": {
        "id": {
          "$ref": "common-v1.schema.json#/$defs/sourceId"
        },
        "kind": {
          "enum": [
            "conversation",
            "repository_file",
            "document",
            "web_page",
            "user_statement",
            "tool_output",
            "observation",
            "other"
          ]
        },
        "title": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "uri": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "revision": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "integrity": {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "content_hash": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        },
        "captured_at": {
          "$ref": "common-v1.schema.json#/$defs/utcTimestamp"
        },
        "media_type": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "created_by": {
          "$ref": "common-v1.schema.json#/$defs/compilationId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "integrity": {
                "const": "verified"
              }
            },
            "required": [
              "integrity"
            ]
          },
          "then": {
            "required": [
              "content_hash"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "integrity": {
                "const": "unverified"
              }
            },
            "required": [
              "integrity"
            ]
          },
          "then": {
            "required": [
              "metadata"
            ],
            "properties": {
              "metadata": {
                "minProperties": 1
              }
            },
            "not": {
              "required": [
                "content_hash"
              ]
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "partially_verified",
            "verified",
            "contradicted"
          ]
        },
        "note": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "relation",
        "method",
        "locator",
        "observed_at"
      ],
      "properties": {
        "source_id": {
          "$ref": "common-v1.schema.json#/$defs/sourceId"
        },
        "relation": {
          "enum": [
            "supports",
            "refutes",
            "contextualizes"
          ]
        },
        "method": {
          "enum": [
            "user_statement",
            "direct_observation",
            "document_read",
            "code_inspection",
            "test_result",
            "tool_result",
            "inference"
          ]
        },
        "locator": {
          "$ref": "common-v1.schema.json#/$defs/locator"
        },
        "observed_at": {
          "$ref": "common-v1.schema.json#/$defs/utcTimestamp"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "note": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "directSupportingEvidence": {
      "type": "object",
      "required": [
        "relation",
        "method"
      ],
      "properties": {
        "relation": {
          "const": "supports"
        },
        "method": {
          "enum": [
            "user_statement",
            "direct_observation",
            "document_read",
            "code_inspection",
            "test_result",
            "tool_result"
          ]
        }
      }
    },
    "directRefutingEvidence": {
      "type": "object",
      "required": [
        "relation",
        "method"
      ],
      "properties": {
        "relation": {
          "const": "refutes"
        },
        "method": {
          "enum": [
            "user_statement",
            "direct_observation",
            "document_read",
            "code_inspection",
            "test_result",
            "tool_result"
          ]
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target_id"
      ],
      "properties": {
        "type": {
          "enum": [
            "supersedes",
            "depends_on",
            "blocks",
            "answers",
            "mitigates",
            "implements",
            "adopts",
            "contradicts",
            "related_to"
          ]
        },
        "target_id": {
          "$ref": "common-v1.schema.json#/$defs/recordId"
        },
        "note": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "kind",
        "state",
        "title",
        "summary",
        "scope",
        "tags",
        "verification",
        "evidence",
        "relations",
        "content",
        "created_at",
        "updated_at",
        "created_by",
        "updated_by",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "common-v1.schema.json#/$defs/recordId"
        },
        "key": {
          "$ref": "common-v1.schema.json#/$defs/slug"
        },
        "kind": {
          "enum": [
            "fact",
            "decision",
            "assumption",
            "constraint",
            "preference",
            "proposal",
            "task",
            "question",
            "risk",
            "event"
          ]
        },
        "state": {
          "type": "string"
        },
        "title": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "summary": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "scope": {
          "$ref": "#/$defs/nonEmptySlugArray"
        },
        "tags": {
          "$ref": "#/$defs/slugArray"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "relations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "content": {
          "type": "object"
        },
        "created_at": {
          "$ref": "common-v1.schema.json#/$defs/utcTimestamp"
        },
        "updated_at": {
          "$ref": "common-v1.schema.json#/$defs/utcTimestamp"
        },
        "created_by": {
          "$ref": "common-v1.schema.json#/$defs/compilationId"
        },
        "updated_by": {
          "$ref": "common-v1.schema.json#/$defs/compilationId"
        },
        "content_hash": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fact"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "enum": [
                  "active",
                  "obsolete"
                ]
              },
              "content": {
                "$ref": "#/$defs/factContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "decision"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "enum": [
                  "active",
                  "obsolete"
                ]
              },
              "content": {
                "$ref": "#/$defs/decisionContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "assumption"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "enum": [
                  "active",
                  "invalidated",
                  "obsolete"
                ]
              },
              "content": {
                "$ref": "#/$defs/assumptionContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "constraint"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "enum": [
                  "active",
                  "obsolete"
                ]
              },
              "content": {
                "$ref": "#/$defs/constraintContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "preference"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "enum": [
                  "active",
                  "obsolete"
                ]
              },
              "content": {
                "$ref": "#/$defs/preferenceContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "proposal"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "state": {
                    "enum": [
                      "proposed",
                      "accepted"
                    ]
                  },
                  "content": {
                    "$ref": "#/$defs/proposalContent"
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "rejected"
                  },
                  "content": {
                    "$ref": "#/$defs/rejectedProposalContent"
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "cancelled"
                  },
                  "content": {
                    "$ref": "#/$defs/cancelledProposalContent"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "task"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "state": {
                    "enum": [
                      "todo",
                      "in_progress",
                      "blocked"
                    ]
                  },
                  "content": {
                    "$ref": "#/$defs/taskContent"
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "done"
                  },
                  "content": {
                    "$ref": "#/$defs/doneTaskContent"
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "cancelled"
                  },
                  "content": {
                    "$ref": "#/$defs/cancelledTaskContent"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "question"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "state": {
                    "enum": [
                      "open",
                      "obsolete"
                    ]
                  },
                  "content": {
                    "$ref": "#/$defs/questionContent"
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "answered"
                  },
                  "content": {
                    "$ref": "#/$defs/answeredQuestionContent"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "risk"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "state": {
                    "enum": [
                      "open",
                      "mitigated"
                    ]
                  },
                  "content": {
                    "$ref": "#/$defs/riskContent"
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "accepted"
                  },
                  "content": {
                    "$ref": "#/$defs/acceptedRiskContent"
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "closed"
                  },
                  "content": {
                    "$ref": "#/$defs/closedRiskContent"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "event"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "occurred"
              },
              "content": {
                "$ref": "#/$defs/eventContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification": {
                "properties": {
                  "status": {
                    "const": "verified"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "contains": {
                  "$ref": "#/$defs/directSupportingEvidence"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification": {
                "properties": {
                  "status": {
                    "const": "partially_verified"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification": {
                "properties": {
                  "status": {
                    "const": "contradicted"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "contains": {
                  "$ref": "#/$defs/directRefutingEvidence"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "assumption"
              },
              "state": {
                "const": "invalidated"
              }
            },
            "required": [
              "kind",
              "state"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "contains": {
                  "$ref": "#/$defs/directRefutingEvidence"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "task"
              },
              "state": {
                "const": "done"
              }
            },
            "required": [
              "kind",
              "state"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "contains": {
                  "$ref": "#/$defs/directSupportingEvidence"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "risk"
              },
              "state": {
                "const": "closed"
              }
            },
            "required": [
              "kind",
              "state"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "contains": {
                  "$ref": "#/$defs/directSupportingEvidence"
                }
              }
            }
          }
        }
      ]
    },
    "factContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "context": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "implications": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "decisionContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "rationale"
      ],
      "properties": {
        "decision": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "rationale": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "context": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "alternatives": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "consequences": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "assumptionContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption",
        "basis",
        "impact_if_false",
        "validation_plan"
      ],
      "properties": {
        "assumption": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "basis": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "impact_if_false": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "validation_plan": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "constraintContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint"
      ],
      "properties": {
        "constraint": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "rationale": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "consequences": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "preferenceContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preference"
      ],
      "properties": {
        "preference": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "rationale": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "applies_to": {
          "$ref": "#/$defs/nonEmptySlugArray"
        }
      }
    },
    "proposalContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "motivation"
      ],
      "properties": {
        "proposal": {
          "$ref": "common-v1.schema.json#/$defs/nonEmptyString"
        },
        "motivation": {
